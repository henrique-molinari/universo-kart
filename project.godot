[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="karts"
3d_render/layer_3="effects"
3d_render/layer_11="player1_only"
3d_render/layer_12="player2_only"
3d_physics/layer_1="world_road"
3d_physics/layer_2="world_wall"
3d_physics/layer_3="world_terrain"
3d_physics/layer_4="kart"
3d_physics/layer_5="item_pickup"
3d_physics/layer_6="projectile"
3d_physics/layer_7="trigger"
3d_physics/layer_8="scenery"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.56, 0.76, 1, 1)
environment/screen_space_reflection/roughness_quality=0
